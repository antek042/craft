---
BasedOnStyle: Google
Language: Cpp
Standard: Latest
IndentWidth: 4
AccessModifierOffset: -4
ContinuationIndentWidth: 4
DerivePointerAlignment: false
PointerAlignment: Left
InsertBraces: true
IncludeBlocks: Regroup
IncludeCategories:
  # C system headers
  - Regex: '^<[a-z_/]+\.h>$'
    Priority: 1
  # C++ standard library
  - Regex: '^<[a-z_]+>$'
    Priority: 2
  # Other libraries
  - Regex: '^<.*>$'
    Priority: 3
  # Project headers
  - Regex: '^"craft/'
    Priority: 4
  - Regex: '.*'
    Priority: 5
